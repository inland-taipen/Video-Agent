# Copy this file to .env and fill in your values

# LLM keys (backend proxy)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Image generation
GEMINI_IMAGE_KEY=your_gemini_image_key_here   # optional, falls back to GEMINI_API_KEY
POLLINATIONS_API_KEY=                          # optional
HF_TOKEN=                                      # optional (HuggingFace)

# TTS settings (ElevenLabs premium voice — highly recommended)
# Get a free API key at https://elevenlabs.io (10,000 chars/mo free)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # Sarah — use a premade voice; free tier blocks library voices via API

# Legacy TTS settings (if using edge-tts fallback)
TTS_VOICE=en-US-JennyNeural
TTS_RATE=-8%
TTS_PITCH=+0Hz

# Frontend build-time vars (injected by Docker build args / Render)
VITE_BACKEND_URL=http://localhost:8000

# Groq model override (optional)
GROQ_MODEL=openai/gpt-oss-120b

# Primary LLM for the Stories pipeline (optional; falls back to Groq → Gemini)
AICREDITS_API_KEY=

# ── AI Digital Legacy ────────────────────────────────────────────────────────
# Uses GROQ_API_KEY (Whisper speech-to-text + chat) and GEMINI_API_KEY
# (embeddings + memory extraction). Both have free tiers; everything falls back
# to offline mocks if they're missing or rejected.
# Production (Render): hosted Postgres + Supabase Storage so data survives deploys.
# Use the Supabase *Session pooler* URI (Render has no IPv6). See DIGITAL_LEGACY.md → Deploying.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# LEGACY_STORAGE=supabase                 # 'local' (default, dev) or 'supabase'
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=              # secret, server only
# LEGACY_STORAGE_BUCKET=legacy            # private bucket, created automatically
# LEGACY_DATA_DIR=backend/data            # dev SQLite DB + local files / cloud file cache
# LEGACY_CHAT_LLM_ORDER=groq,gemini       # live conversation, first that works wins
# LEGACY_EXTRACT_LLM_ORDER=gemini,groq    # memory extraction from transcripts
# LEGACY_GROQ_MODEL=openai/gpt-oss-120b
# LEGACY_GEMINI_MODEL=gemini-3.1-flash-lite
# LEGACY_WHISPER_MODEL=whisper-large-v3-turbo
# LEGACY_EMBEDDINGS=gemini                # 'gemini' or 'local' (offline mock)
# LEGACY_MIN_RELEVANCE=0.52               # how close a memory must be to count as grounding
# LEGACY_MAX_UPLOAD_MB=200
# LEGACY_ENABLE_ELEVENLABS=0              # deferred: server-side voice provider
